# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers)
DATABASE_URL=

# NextAuth: random secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Public URL of the site, e.g. https://havena-booking.vercel.app
# (not needed locally; on Vercel it is detected automatically, but setting it is recommended)
NEXTAUTH_URL=

# OAuth apps (callback URL: <site>/api/auth/callback/github and /google)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (unsigned upload preset); NEXT_PUBLIC_ = available in the browser
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_UPLOAD_PRESET=
